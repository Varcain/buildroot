#!/bin/sh

# Five-minute (by default) lvmusic + HTTP receive + SQLite/SD workload.
# The Lua benchmark implements the same priorities and data operations through
# LuaSocket and LuaDBI; this version deliberately exercises Hush and CLI tools.

duration="${1:-300}"
plan=/data/.ove-hammer-plan.sql
database=/data/.ove-hammer-shell.db

make_plan()
{
	awk 'BEGIN {
		print ".bail on"
		print ".output /dev/null"
		print "PRAGMA journal_mode=DELETE;PRAGMA synchronous=FULL;PRAGMA temp_store=MEMORY;CREATE TABLE events(id INTEGER PRIMARY KEY,payload BLOB);CREATE TABLE meta(n INTEGER NOT NULL);INSERT INTO meta VALUES(0);"
		print ".output /tmp/ove-shell-db-ok"
		txn="BEGIN IMMEDIATE;INSERT INTO events(payload) VALUES(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024));UPDATE meta SET n=n+8;DELETE FROM events WHERE id<(SELECT max(id)-127 FROM events);SELECT 1;COMMIT;"
		for (i=1; i<=20000; i++) {
			print txn
			if (i%20 == 0) print "VACUUM;"
		}
	}' >"$plan"
}

rm -f /tmp/ove-hammer.stop /tmp/ove-shell-db-ok /tmp/ove-shell-db-err
rm -f "$database" "$database-journal" "$database-wal" "$database-shm"
if [ ! -s "$plan" ]; then
	printf '__HAMMER_SETUP__:generating-sql-plan\n'
	make_plan || exit 2
fi

nice -n -5 /usr/bin/lvmusic &
lv_pid=$!
# Let the demo intro reach the player screen before injecting the Play tap.
sleep 15
/usr/bin/touchctl tap 120 160 1500 || exit 3
sleep 2

nice -n 10 wget -q -T 420 -O /dev/null http://172.1.1.1:8082/stream &
net_pid=$!
nice -n 0 sqlite3 "$database" <"$plan" >/tmp/ove-shell-db-out 2>/tmp/ove-shell-db-err &
db_pid=$!

printf '__HAMMER_BEGIN__:shell duration=%s lvmusic=%s network=%s sqlite=%s\n' \
	"$duration" "$lv_pid" "$net_pid" "$db_pid"
printf '__RT_SCOPE_BEFORE__\n'
cat /proc/rt_scope
printf '__RT_SCOPE_BEFORE_END__\n'

sleep "$duration"

kill -9 "$net_pid" "$db_pid" "$lv_pid" 2>/dev/null
wait "$net_pid" 2>/dev/null
wait "$db_pid" 2>/dev/null
wait "$lv_pid" 2>/dev/null

transactions=0
if [ -f /tmp/ove-shell-db-ok ]; then
	transactions="$(wc -l </tmp/ove-shell-db-ok)"
fi
printf '__HAMMER_SQLITE__:transactions=%s rows=%s\n' "$transactions" "$((transactions * 8))"
sqlite3 "$database" 'PRAGMA integrity_check;SELECT n FROM meta;SELECT count(*) FROM events;'
printf '__HAMMER_DB_ERROR_BYTES__:'
wc -c </tmp/ove-shell-db-err
printf '__RT_SCOPE_AFTER__\n'
cat /proc/rt_scope
printf '__RT_SCOPE_AFTER_END__\n'
printf '__FS_AFTER__\n'
cat /proc/lxp_fs
printf '__FS_AFTER_END__\n'
printf '__HAMMER_END__:shell\n'

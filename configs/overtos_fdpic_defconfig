BR2_arm=y
BR2_cortex_m4=y
BR2_BINFMT_FDPIC=y
BR2_PTHREADS=y
# BR2_UCLIBC_INSTALL_UTILS is not set
BR2_ENABLE_LTO=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_ROOTFS_OVERLAY="board/overtos/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/overtos/post-build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG="board/overtos/busybox.config"
BR2_PACKAGE_OVERTOS_LVBENCH=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# HTTPS from the personality (P5): curl + mbedTLS (library only — the mbedtls
# companion programs are MMU-gated; the lib is NoMMU/FDPIC-OK) + a CA bundle.
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_MBEDTLS=y
# BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_CA_CERTIFICATES=y
# Interactive network login (SSH): dropbear is the NoMMU/FDPIC-OK SSH server
# (openssh is BR2_USE_MMU-gated). Server only, bundled crypto (SMALL, no OpenSSL),
# reverse-DNS off. The personality's /dev/ptmx + /dev/pts/N give it an interactive
# pty; root password auth (below) — dropbear refuses a blank password.
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_TARGET_ROOTFS_CPIO=y
# BR2_TARGET_ROOTFS_TAR is not set

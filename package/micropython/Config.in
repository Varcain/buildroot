config BR2_PACKAGE_MICROPYTHON
	bool "micropython"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	help
	  MicroPython is a lean and fast implementation of the Python
	  3 programming language that is optimised to run on a
	  microcontroller.

	  https://micropython.org

if BR2_PACKAGE_MICROPYTHON

config BR2_PACKAGE_MICROPYTHON_LIB
	bool "micropython-lib"
	help
	  Core Python libraries ported to MicroPython.

	  This contains compatible but reduced-functionality versions
	  of some Python standard library and wider Python ecosystem
	  modules, as well as some MicroPython-specific libraries
	  that aren't included in the base package.

config BR2_PACKAGE_MICROPYTHON_SQLITE
	bool "sqlite3 module"
	select BR2_PACKAGE_SQLITE
	help
	  Build a small native sqlite3 module into the interpreter. The module
	  exposes connect(), Connection.execute(), Connection.scalar() and
	  Connection.close(), and does not depend on the Unix FFI module.

	  This is suitable for FDPIC targets, where indirect calls through the
	  Unix FFI are not ABI-safe.

if BR2_PACKAGE_MICROPYTHON_LIB

config BR2_PACKAGE_MICROPYTHON_LIB_UNIXFFI
	bool "micropython-lib unix-ffi modules"
	default y
	depends on !BR2_BINFMT_FDPIC
	select BR2_PACKAGE_LIBFFI
	select BR2_PACKAGE_PCRE2 # runtime
	help
	  Unix-specific MicroPython packages

	  These provide additional functionality to MicroPython in
	  standard environments.

comment "micropython-lib unix-ffi modules need a non-FDPIC toolchain"
	depends on BR2_BINFMT_FDPIC

endif # BR2_PACKAGE_MICROPYTHON_LIB

endif # BR2_PACKAGE_MICROPYTHON

comment "micropython needs a toolchain w/ threads, dynamic library"
	depends on !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS

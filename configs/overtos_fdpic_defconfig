BR2_arm=y
BR2_cortex_m4=y
BR2_BINFMT_FDPIC=y
BR2_PTHREADS=y
# BR2_UCLIBC_INSTALL_UTILS is not set
BR2_ENABLE_LTO=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_ROOTFS_OVERLAY="board/overtos/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/overtos/post-build.sh board/overtos/strip-fdpic.sh"
BR2_PACKAGE_BUSYBOX_CONFIG="board/overtos/busybox.config"
BR2_PACKAGE_OVERTOS_LVBENCH=y
# Scriptable Linux-personality benchmark runtime. Keep the database, socket,
# process/POSIX, filesystem and structured-output bindings together so the
# same Lua controller runs unchanged on every RTOS seam.
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_LUA_32BITS=y
BR2_PACKAGE_LUA_READLINE=y
BR2_PACKAGE_LUA_ARGPARSE=y
BR2_PACKAGE_LUA_CJSON=y
BR2_PACKAGE_LUA_OVE_PROCESS=y
BR2_PACKAGE_LUADBI=y
BR2_PACKAGE_LUADBI_SQLITE3=y
BR2_PACKAGE_LUAFILESYSTEM=y
BR2_PACKAGE_LUASOCKET=y
BR2_PACKAGE_SQLITE=y
# Preserve the already-shipped secondary scripting runtime when regenerating
# this defconfig; its FDPIC-safe configuration deliberately excludes Unix FFI.
BR2_PACKAGE_MICROPYTHON=y
BR2_PACKAGE_MICROPYTHON_LIB=y
BR2_PACKAGE_MICROPYTHON_SQLITE=y
BR2_PACKAGE_MICROPYTHON_OVE_PROCESS=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# HTTPS from the personality (P5): curl + mbedTLS (library only — the mbedtls
# companion programs are MMU-gated; the lib is NoMMU/FDPIC-OK) + a CA bundle.
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_MBEDTLS=y
# BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_CA_CERTIFICATES=y
# Interactive network login (SSH): dropbear is the NoMMU/FDPIC-OK SSH server
# (openssh is BR2_USE_MMU-gated). Server only, bundled crypto (SMALL, no OpenSSL),
# reverse-DNS off. The personality's /dev/ptmx + /dev/pts/N give it an interactive
# pty; root password auth (below) — dropbear refuses a blank password.
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_TARGET_ROOTFS_CPIO=y
# BR2_TARGET_ROOTFS_TAR is not set

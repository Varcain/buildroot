#!/bin/sh

# Native Linux five-minute lvmusic + HTTP receive + SQLite/FAT workload.
duration="${1:-300}"
data_directory=/data/.native-linux-hammer
database=$data_directory/shell.db
net_result=/tmp/native-hammer-net.json
latency_result=/tmp/native-hammer-latency.json
rt_scope_result=/tmp/native-hammer-rt-scope.txt
lvgl_log=/tmp/native-hammer-lvgl.log
lvgl_log_all=/tmp/native-hammer-lvgl-all.log
uinput_event=/run/native-hammer-uinput.event
uinput_control=/run/native-hammer-uinput.control
sqlite_input=/run/native-hammer-sqlite.in
sqlite_output=/run/native-hammer-sqlite.out
db_errors=/tmp/native-hammer-db-errors
sqlite_helper="${HAMMER_SQLITE:-/usr/bin/hammer-sqlite}"
transaction='BEGIN IMMEDIATE;INSERT INTO events(payload) VALUES(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024)),(randomblob(1024));UPDATE meta SET n=n+8;DELETE FROM events WHERE id<(SELECT max(id)-127 FROM events);COMMIT;'
vacuum_sql='PRAGMA temp_store_directory="/data/.native-linux-hammer";VACUUM;'

lv_pid=
net_pid=
latency_pid=
latency_mode=
uinput_pid=
sqlite_pid=

dump_file()
{
	# BusyBox cat may need a high-order NOMMU allocation when execing under the
	# full hammer load.  Read procfs/sysfs files in the resident shell so the
	# observer cannot perturb (or OOM) the measured workload.
	while IFS= read -r dump_line || [ -n "$dump_line" ]; do
		printf '%s\n' "$dump_line"
	done <"$1"
}

cleanup()
{
	trap - EXIT INT TERM HUP
	[ -n "$net_pid" ] && kill "$net_pid" 2>/dev/null
	[ -n "$latency_pid" ] && kill "$latency_pid" 2>/dev/null
	[ -n "$lv_pid" ] && kill "$lv_pid" 2>/dev/null
	[ -n "$uinput_pid" ] && kill "$uinput_pid" 2>/dev/null
	[ -n "$sqlite_pid" ] && kill "$sqlite_pid" 2>/dev/null
	exec 3>&-
	exec 4<&-
	rm -f "$sqlite_input" "$sqlite_output"
}
trap cleanup EXIT INT TERM HUP

sqlite_request()
{
	sqlite_sql="$1"
	sqlite_result="$2"
	: >"$sqlite_result"
	printf '%s\n' "$sqlite_sql" >&3 || return 1
	while IFS= read -r sqlite_line <&4; do
		case "$sqlite_line" in
			__HAMMER_SQLITE_STATUS__:0)
				return 0
				;;
			__HAMMER_SQLITE_STATUS__:*)
				return "${sqlite_line##*:}"
				;;
			*)
				printf '%s\n' "$sqlite_line" >>"$sqlite_result"
				;;
		esac
	done
	return 1
}

snapshot()
{
	label="$1"
	printf '__SNAPSHOT_%s_BEGIN__\n' "$label"
	printf '[uptime]\n'
	dump_file /proc/uptime
	printf '[meminfo]\n'
	dump_file /proc/meminfo
	printf '[stat]\n'
	dump_file /proc/stat
	printf '[interrupts]\n'
	dump_file /proc/interrupts
	printf '[rt-scope]\n'
	[ -r /proc/rt_scope ] && dump_file /proc/rt_scope
	printf '[mounts]\n'
	dump_file /proc/mounts
	printf '[diskstats]\n'
	dump_file /proc/diskstats
	printf '[block-stat]\n'
	for block_stat in /sys/class/block/mmcblk*/stat; do
		[ -r "$block_stat" ] || continue
		printf '%s ' "$block_stat"
		dump_file "$block_stat"
	done
	printf '[processes]\n'
	for measured_pid in "$$" "$lv_pid" "$net_pid" "$latency_pid" \
		"$sqlite_pid"; do
		[ -n "$measured_pid" ] || continue
		[ -r "/proc/$measured_pid/stat" ] || continue
		dump_file "/proc/$measured_pid/stat"
	done
	# The physical response worker is a kernel thread, not a child PID known to
	# this shell. Discover it without spawning ps/grep under measurement load.
	for comm_path in /proc/[0-9]*/comm; do
		[ -r "$comm_path" ] || continue
		IFS= read -r comm_name <"$comm_path" || continue
		[ "$comm_name" = rt-scope ] || continue
		measured_pid="${comm_path#/proc/}"
		measured_pid="${measured_pid%/comm}"
		[ -r "/proc/$measured_pid/stat" ] && \
			dump_file "/proc/$measured_pid/stat"
	done
	printf '__SNAPSHOT_%s_END__\n' "$label"
}

case "$duration" in
	*[!0-9]*|'') exit 2 ;;
esac
[ "$duration" -gt 0 ] && [ "$duration" -le 3600 ] || exit 2

grep -q ' /data vfat ' /proc/mounts || {
	echo 'native-linux-hammer: /data is not mounted as VFAT' >&2
	exit 4
}
grep -Eq ' / (ext2|cramfs|squashfs) ro[, ]' /proc/mounts || {
	echo 'native-linux-hammer: root filesystem is not a supported read-only filesystem' >&2
	exit 4
}

framebuffer=
for candidate in /dev/fb*; do
	[ -c "$candidate" ] || continue
	framebuffer="$candidate"
	break
done
[ -n "$framebuffer" ] || {
	echo 'native-linux-hammer: no framebuffer device' >&2
	exit 3
}
[ -c /dev/uinput ] || {
	echo 'native-linux-hammer: /dev/uinput is absent' >&2
	exit 3
}

# SQLite randomblob() reads the kernel RNG.  On fast QSPI boots Dropbear may
# already have host keys and therefore not wait for CRNG initialization.
# Keep that boot-time wait outside the measured workload.
dd if=/dev/random of=/dev/null bs=1 count=1 2>/dev/null || exit 4

physical_input=
for name_path in /sys/class/input/event*/device/name; do
	[ -r "$name_path" ] || continue
	read -r input_name <"$name_path"
	case "$input_name" in
		*FT*|*ft*|*Touch*|*touch*)
			event_name="${name_path#/sys/class/input/}"
			event_name="${event_name%%/*}"
			physical_input="/dev/input/$event_name"
			break
			;;
	esac
done

rm -f "$net_result" "$latency_result" "$rt_scope_result" \
	"$lvgl_log" "$lvgl_log_all" "$db_errors" \
	/tmp/native-hammer-integrity /tmp/native-hammer-meta \
	/tmp/native-hammer-live /tmp/native-hammer-retry-meta \
	"$sqlite_input" "$sqlite_output"
mkdir -p "$data_directory" || exit 4
rm -f "$database" "$database-journal" "$database-wal" "$database-shm"

/usr/bin/hammer-uinput "$uinput_event" "$uinput_control" \
	>/tmp/native-hammer-uinput.log 2>&1 &
uinput_pid=$!
attempt=0
while [ "$attempt" -lt 100 ] && [ ! -s "$uinput_event" ]; do
	kill -0 "$uinput_pid" 2>/dev/null || break
	attempt=$((attempt + 1))
	sleep 1
done
[ -s "$uinput_event" ] || {
	cat /tmp/native-hammer-uinput.log >&2
	exit 3
}
read -r automation_input <"$uinput_event"

# FDPIC must allocate lvmusic's roughly 1 MiB load segment contiguously on
# this NOMMU target. Reclaim clean QSPI pages and launch it before the SQLite
# helper can fragment the only order-8 buddy block.
if grep -Eq 'root=(/dev/mtdblock0|mtd:rootfs)' /proc/cmdline &&
	[ -w /proc/sys/vm/drop_caches ]; then
	echo 3 >/proc/sys/vm/drop_caches
fi

LVGL_FBDEV="$framebuffer" LVGL_EVDEV="$automation_input" \
	LVGL_EVDEV_SECONDARY="$physical_input" \
	/bin/nice -n -5 /usr/bin/lvmusic >"$lvgl_log_all" 2>&1 &
lv_pid=$!
sleep 15
kill -0 "$lv_pid" 2>/dev/null || {
	cat "$lvgl_log_all" >&2
	exit 3
}
printf 'tap 120 160 1500\n' >"$uinput_control" || exit 3
sleep 2
# Remember the active-player boundary without truncating a file that lvmusic
# still has open. The active-only copy is materialized after the run.
lvgl_start_line=$(wc -l <"$lvgl_log_all")

# Coalesce any clean pages faulted while starting the player before exec needs
# one order-6 segment for SQLite's bounded 240 KiB MEMSYS5 arena.  Keeping the
# complete FDPIC data segment below 256 KiB is required by PREEMPT_RT's SLUB
# footprint on this 8 MiB NOMMU board; the workload uses a 16 KiB page cache.
if grep -Eq 'root=(/dev/mtdblock0|mtd:rootfs)' /proc/cmdline &&
	[ -w /proc/sys/vm/drop_caches ]; then
	echo 3 >/proc/sys/vm/drop_caches
fi

mkfifo "$sqlite_input" "$sqlite_output" || exit 4
"$sqlite_helper" "$database" --batch "$sqlite_input" "$sqlite_output" \
	2>"$db_errors" &
sqlite_pid=$!
exec 3>"$sqlite_input"
exec 4<"$sqlite_output"
sqlite_request \
	'PRAGMA journal_mode=DELETE;PRAGMA synchronous=FULL;PRAGMA temp_store=FILE;PRAGMA temp_store_directory="/data/.native-linux-hammer";PRAGMA cache_size=-16;PRAGMA mmap_size=0;DROP TABLE IF EXISTS events;DROP TABLE IF EXISTS meta;CREATE TABLE events(id INTEGER PRIMARY KEY,payload BLOB);CREATE TABLE meta(n INTEGER NOT NULL);INSERT INTO meta VALUES(0);' \
	/dev/null || exit 4

/usr/bin/wget -q -T 2 -O /dev/null http://172.1.1.1:8082/reset || exit 6
/bin/nice -n 10 /usr/bin/wget -q -T "$((duration + 30))" -O /dev/null \
	"http://172.1.1.1:8082/stream?seconds=$duration" &
net_pid=$!
network_ready=0
attempt=0
while [ "$attempt" -lt 100 ]; do
	if /usr/bin/wget -q -T 1 -O /dev/null http://172.1.1.1:8082/ready; then
		network_ready=1
		break
	fi
	attempt=$((attempt + 1))
	sleep 1
done
[ "$network_ready" -eq 1 ] || exit 6

if [ -r /proc/rt_scope ] && grep -q '^available 1$' /proc/rt_scope; then
	latency_mode=tim3-hardware-to-sched-fifo-kthread
else
	latency_mode=timer-to-sched-fifo
	/usr/bin/linux-rt-latency "$duration" >"$latency_result" \
		2>/tmp/native-hammer-latency-error &
	latency_pid=$!
fi

printf '__HAMMER_BEGIN__:native-linux-shell duration=%s lvmusic=%s network=%s latency=%s network_ready=1 framebuffer=%s automation_input=%s physical_input=%s\n' \
	"$duration" "$lv_pid" "$net_pid" "$latency_mode" "$framebuffer" \
	"$automation_input" "${physical_input:-none}"
snapshot BEFORE

# Reset only the Linux driver's statistics; TIM3 and both oscilloscope
# waveforms remain continuous. Keep this next to the workload uptime boundary
# so release accounting covers the same transaction-complete interval.
if [ "$latency_mode" = tim3-hardware-to-sched-fifo-kthread ]; then
	printf 'reset\n' >/proc/rt_scope || exit 5
fi

submitted=0
transaction_retries=0
failure=none
IFS=' .' read -r started_seconds started_fraction ignored </proc/uptime
started_uptime="${started_seconds}.${started_fraction}"
# /proc/uptime has two fractional digits. Prefixing them with 1 avoids the
# shell treating values such as 08 as octal without requiring non-POSIX 10#.
started_centiseconds=$((started_seconds * 100 + 1$started_fraction - 100))
deadline_centiseconds=$((started_centiseconds + duration * 100))
while :; do
	IFS=' .' read -r uptime_seconds uptime_fraction ignored </proc/uptime
	uptime_centiseconds=$((uptime_seconds * 100 + 1$uptime_fraction - 100))
	[ "$uptime_centiseconds" -ge "$deadline_centiseconds" ] && break
	transaction_attempt=0
	while :; do
		sqlite_request "$transaction" /dev/null
		transaction_status=$?
		[ "$transaction_status" -eq 0 ] && break
		transaction_retries=$((transaction_retries + 1))
		sqlite_request 'SELECT n FROM meta;' \
			/tmp/native-hammer-retry-meta
		read -r retry_meta </tmp/native-hammer-retry-meta
		expected_before=$((submitted * 8))
		expected_after=$(((submitted + 1) * 8))
		if [ "$retry_meta" = "$expected_after" ]; then
			transaction_status=0
			break
		fi
		if [ "$retry_meta" != "$expected_before" ]; then
			failure=transaction-counter
			break
		fi
		transaction_attempt=$((transaction_attempt + 1))
		if [ "$transaction_attempt" -ge 3 ]; then
			failure="transaction-$transaction_status"
			break
		fi
		sleep 1
	done
	[ "$failure" != none ] && break
	submitted=$((submitted + 1))
	if [ $((submitted % 20)) -eq 0 ]; then
		if ! sqlite_request "$vacuum_sql" /dev/null; then
			failure=vacuum
			break
		fi
	fi
done
IFS=' ' read -r ended_uptime ignored </proc/uptime
scope_captured_uptime="$ended_uptime"
if [ "$latency_mode" = tim3-hardware-to-sched-fifo-kthread ]; then
	# The driver exports its own atomic measurement_elapsed_ns. Keep this
	# userspace timestamp only as a backward-compatible observer record.
	IFS=' ' read -r scope_captured_uptime ignored </proc/uptime
	dump_file /proc/rt_scope >"$rt_scope_result" || {
		[ "$failure" = none ] && failure=latency
	}
fi
snapshot AFTER

# The measured interval and its process/CPU snapshot are now complete. Free
# lvmusic's large FDPIC segment before running any post-processing utilities.
kill "$lv_pid" 2>/dev/null
wait "$lv_pid" 2>/dev/null
lv_pid=
kill "$uinput_pid" 2>/dev/null
wait "$uinput_pid" 2>/dev/null
uinput_pid=

attempt=0
while [ "$attempt" -lt 600 ]; do
	if /usr/bin/wget -q -T 2 -O "$net_result" \
		http://172.1.1.1:8082/metrics &&
		grep -q '"active": 0' "$net_result"; then
		break
	fi
	attempt=$((attempt + 1))
	sleep 1
done
if ! grep -q '"completed": 1' "$net_result" 2>/dev/null ||
	! grep -q '"errors": 0' "$net_result" 2>/dev/null; then
	[ "$failure" = none ] && failure=network
	[ -n "$net_pid" ] && kill "$net_pid" 2>/dev/null
fi
net_pid=

if [ -n "$latency_pid" ]; then
	if ! wait "$latency_pid"; then
		[ "$failure" = none ] && failure=latency
		cat /tmp/native-hammer-latency-error >&2
	fi
	latency_pid=
fi

sqlite_request 'PRAGMA integrity_check;' /tmp/native-hammer-integrity
read -r integrity </tmp/native-hammer-integrity
sqlite_request 'SELECT n FROM meta;' /tmp/native-hammer-meta
read -r meta </tmp/native-hammer-meta
sqlite_request 'SELECT count(*) FROM events;' /tmp/native-hammer-live
read -r live_rows </tmp/native-hammer-live
exec 3>&-
wait "$sqlite_pid"
sqlite_pid=
exec 4<&-
rm -f "$sqlite_input" "$sqlite_output"
meta=${meta:-unknown}
live_rows=${live_rows:-unknown}
rows=$((submitted * 8))
expected_live=$rows
[ "$expected_live" -gt 128 ] && expected_live=128
error_bytes=$(wc -c <"$db_errors")
sed -n "$((lvgl_start_line + 1)),\$p" "$lvgl_log_all" >"$lvgl_log"
active_samples=$(grep -c 'sysmon: [1-9][0-9]* FPS' "$lvgl_log" 2>/dev/null)
active_samples=${active_samples:-0}
required_samples=30
[ "$duration" -lt 30 ] && required_samples=1

[ "$meta" = "$rows" ] || [ "$failure" != none ] || failure=metadata
[ "$live_rows" = "$expected_live" ] || [ "$failure" != none ] || failure=live-rows
[ "$integrity" = ok ] || [ "$failure" != none ] || failure=integrity
[ "$error_bytes" -eq 0 ] || [ "$failure" != none ] || failure=sqlite-errors
[ "$active_samples" -ge "$required_samples" ] || [ "$failure" != none ] || failure=lvgl-samples

printf '__HAMMER_SQLITE__:transactions=%s rows=%s meta=%s live_rows=%s retries=%s integrity=%s error=%s\n' \
	"$submitted" "$rows" "$meta" "$live_rows" "$transaction_retries" \
	"$integrity" "$failure"
printf '__HAMMER_TIMING__:started_uptime=%s ended_uptime=%s scope_captured_uptime=%s\n' \
	"$started_uptime" "$ended_uptime" "$scope_captured_uptime"
printf '__HAMMER_NETWORK__:'
[ -s "$net_result" ] && cat "$net_result" || echo '{"error":"missing"}'
printf '__HAMMER_LATENCY__:'
[ -s "$latency_result" ] && cat "$latency_result" || echo '{"error":"missing"}'
printf '__HAMMER_RT_SCOPE_BEGIN__\n'
[ -s "$rt_scope_result" ] && cat "$rt_scope_result"
printf '__HAMMER_RT_SCOPE_END__\n'
printf '__HAMMER_LVGL__:active_samples=%s required=%s\n' \
	"$active_samples" "$required_samples"
printf '__HAMMER_DB_ERROR_BYTES__:%s\n' "$error_bytes"
printf '__LVGL_LOG_BEGIN__\n'
cat "$lvgl_log"
printf '__LVGL_LOG_END__\n'
printf '__HAMMER_END__:native-linux-shell\n'

trap - EXIT INT TERM HUP
[ "$failure" = none ]

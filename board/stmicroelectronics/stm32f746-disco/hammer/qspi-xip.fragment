# Execute kernel text and read-only data from the 16 MiB QSPI aperture. The
# legacy U-Boot image header occupies the first 64 bytes of QSPI, so Linux is
# linked immediately after it.
CONFIG_XIP_KERNEL=y
CONFIG_XIP_PHYS_ADDR=0x90000040
CONFIG_XIP_DEFLATED_DATA=y

# The XIP kernel must not reset or reconfigure the controller from which it is
# executing. Root and benchmark data are therefore supplied by SD.
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# CONFIG_SQUASHFS is not set

# Root and /data must be available before PID 1; no late module load is needed.
# CONFIG_MODULES is not set
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_ARMMMCI=y
CONFIG_MMC_STM32_SDMMC=y

# The image uses an MBR written by genimage, not GPT/EFI partitions.
# CONFIG_EFI_PARTITION is not set

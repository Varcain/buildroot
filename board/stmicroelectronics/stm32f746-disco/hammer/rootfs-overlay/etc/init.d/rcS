#!/bin/sh

hostname stm32f746-linux
ip link set lo up

# The QSPI profile leaves only a few hundred KiB after DRM and the supported
# 64-entry Ethernet rings are active.  Linux's default 256 KiB low-memory
# reserve then invokes the OOM killer even though enough pages remain for the
# tiny init/getty processes.  Keep a 64 KiB emergency reserve on this
# single-purpose 8 MiB image.  Do not change the SD baseline's VM policy.
if grep -Eq 'root=(/dev/mtdblock0|mtd:rootfs)' /proc/cmdline && \
	[ -w /proc/sys/vm/min_free_kbytes ]; then
	echo 64 >/proc/sys/vm/min_free_kbytes
fi

mkdir -p /run/dropbear
if [ -d /sys/kernel/debug ]; then
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
fi

# On the QSPI-root build the STM32 MMCI host is a module. Loading it before
# PID 1 fragmented the order-7 FDPIC mappings; loading it afterward works but
# the card stack consumes the remaining order-0 reserve. Keep it as an
# explicit diagnostic option until kernel XIP releases enough SDRAM. The SD
# baseline has the driver built in, so this block is a no-op there.
if grep -qw qspi_mmc=1 /proc/cmdline; then
	for mmci_module in /lib/modules/*/kernel/drivers/mmc/host/armmmci.ko; do
		if [ -f "$mmci_module" ]; then
			insmod "$mmci_module" || \
				echo "native Linux hammer: MMCI module load failed (continuing without SD)"
		fi
	done

	# Give an inserted card time to enumerate, but do not require it for boot.
	mmc_wait=0
	while [ ! -b /dev/mmcblk0 ] && [ "$mmc_wait" -lt 20 ]; do
		usleep 100000
		mmc_wait=$((mmc_wait + 1))
	done
fi

# A VFAT SD partition is required for a comparable hammer run, but it is not
# required merely to boot the QSPI image.  Mount it only when it exists so the
# synchronous BusyBox init path never waits on an absent partition.  NOMMU
# kernels cannot provide tmpfs, so use an otherwise-empty ramfs for bring-up.
# The hammer preflight rejects ramfs and therefore cannot report it as parity.
if ! grep -q '[[:space:]]/data[[:space:]]' /proc/mounts; then
	data_device=
	for candidate in /dev/mmcblk0p2 /dev/mmcblk0p1; do
		if [ -b "$candidate" ] && \
			mount -t vfat -o rw,noatime,nosuid,nodev,noexec,flush,fmask=0177,dmask=0077 \
				"$candidate" /data; then
			data_device=$candidate
			break
		fi
	done
	if [ -z "$data_device" ]; then
		mount -t ramfs -o nosuid,nodev,mode=0700 ramfs /data || exit 1
		echo "native Linux hammer: /data is volatile ramfs (no benchmark parity)"
	fi
fi
mkdir -p /data/.native-linux

host_key=/data/.native-linux/dropbear_ed25519_host_key
ln -sf "$host_key" /run/dropbear/dropbear_ed25519_host_key
if [ ! -s "$host_key" ]; then
	# Generate the key before Ethernet consumes its fixed RX buffers. Dropbear
	# itself remains inetd-only because fork() is unavailable on NOMMU.
	dropbearkey -t ed25519 -f "$host_key" || exit 1
fi

# Indirect QSPI reads populate the page cache while the read-only root starts.
# Reclaim those clean pages after the SSH server is mapped and before stmmac
# preallocates its 64 receive pages. Without this ordering, the 8 MiB system
# cannot initialize the otherwise valid minimum-size RX ring.
if grep -Eq 'root=(/dev/mtdblock0|mtd:rootfs)' /proc/cmdline && \
	[ -w /proc/sys/vm/drop_caches ]; then
	echo 3 >/proc/sys/vm/drop_caches
fi

if ip link show eth0 >/dev/null 2>&1; then
	ip addr flush dev eth0
	ip addr add 172.1.1.2/24 dev eth0
	ip link set eth0 up
fi

echo "native Linux hammer: console root/root; Ethernet 172.1.1.2/24"

# Parallel hard-float guest rootfs for STM32F746/Cortex-M7. The existing
# overtos_fdpic_defconfig remains the soft-float compatibility build.
BR2_arm=y
BR2_cortex_m7=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_FPV5D16=y
BR2_BINFMT_FDPIC=y
BR2_PTHREADS=y
# BR2_UCLIBC_INSTALL_UTILS is not set
BR2_ENABLE_LTO=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_ROOTFS_OVERLAY="board/overtos/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/overtos/post-build.sh board/overtos/post-build-hardfloat.sh board/overtos/strip-fdpic.sh"
BR2_PACKAGE_BUSYBOX_CONFIG="board/overtos/busybox.config"
BR2_PACKAGE_OVERTOS_LVBENCH=y
# Scriptable Linux-personality benchmark runtime, the same set as
# overtos_fdpic_defconfig: the shell, Lua and MicroPython hammer drivers need
# sqlite3, the Lua database/socket/process/filesystem/JSON bindings and the
# MicroPython sqlite and process modules. Lua keeps the default "no command-line
# editing": readline pulls in ncurses, which needs a wide-char toolchain that
# this configuration does not build.
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_LUA_32BITS=y
BR2_PACKAGE_LUA_ARGPARSE=y
BR2_PACKAGE_LUA_CJSON=y
BR2_PACKAGE_LUA_OVE_PROCESS=y
BR2_PACKAGE_LUADBI=y
BR2_PACKAGE_LUADBI_SQLITE3=y
BR2_PACKAGE_LUAFILESYSTEM=y
BR2_PACKAGE_LUASOCKET=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_MICROPYTHON=y
BR2_PACKAGE_MICROPYTHON_LIB=y
BR2_PACKAGE_MICROPYTHON_SQLITE=y
BR2_PACKAGE_MICROPYTHON_OVE_PROCESS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
# BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_TARGET_ROOTFS_CPIO=y
# BR2_TARGET_ROOTFS_TAR is not set

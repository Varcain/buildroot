# Execute kernel text and read-only data from the 16 MiB QSPI aperture. Place
# the legacy header immediately before the 1 MiB-aligned kernel required by
# the ARMv7 PMSA/MPU implementation.
CONFIG_XIP_KERNEL=y
CONFIG_XIP_PHYS_ADDR=0x90100000
CONFIG_XIP_DEFLATED_DATA=y
CONFIG_ARM_MPU=y
CONFIG_XIP_ROOTFS=y
CONFIG_XIP_ROOTFS_PHYS_ADDR=0x90800000
CONFIG_XIP_ROOTFS_SIZE_ORDER=23

# Expose only the aligned rootfs window as read-only ROM. Do not enable the
# STM32 QSPI/SPI-NOR driver: the kernel is executing through that controller,
# which U-Boot has already placed in memory-mapped mode.
CONFIG_MTD=y
# CONFIG_MTD_BLOCK is not set
CONFIG_MTD_BLOCK_RO=y
CONFIG_MTD_ROM=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_MTD_MAP_BANK_WIDTH_1=y
# CONFIG_SPI is not set
CONFIG_CRAMFS=y
CONFIG_CRAMFS_MTD=y
# CONFIG_CRAMFS_BLOCKDEV is not set
# CONFIG_SQUASHFS is not set

# Root and optional FAT /data must be available before PID 1; no late module
# load is needed.
# CONFIG_MODULES is not set
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_ARMMMCI=y
CONFIG_MMC_STM32_SDMMC=y

# The optional data-only SD image uses an MBR, not GPT/EFI partitions.
# CONFIG_EFI_PARTITION is not set

# Retain live pinctrl ownership evidence for the TIM3/PB4/PG7 scope audit.
CONFIG_DEBUG_FS=y
